{
  "name": "yoump3-local",
  "version": "1.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test",
    "desktop": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "pack": "electron-builder --win --dir --x64",
    "predist": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-source.ps1",
    "test:ui": "electron scripts/check-ui.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "description": "YouMP3 — локальная аудиотека YouTube и SoundCloud",
  "author": "YouMP3",
  "main": "desktop/main.cjs",
  "build": {
    "appId": "local.yoump3.desktop",
    "productName": "YouMP3",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "public/**/*",
      "src/**/*",
      "server.mjs",
      "package.json",
      "THIRD-PARTY-NOTICES.md",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "tools",
        "to": "tools",
        "filter": [
          "*.exe",
          "licenses/**/*"
        ]
      },
      {
        "from": "build/YouMP3-source.zip",
        "to": "YouMP3-source.zip"
      },
      {
        "from": "search-plugins",
        "to": "search-plugins",
        "filter": [
          "**/*.py"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signExecutable": false,
      "icon": "desktop/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "YouMP3-Setup-${version}-${arch}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "L1nuxc",
        "repo": "YouMP3",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "essentia.js": "^0.1.3"
  },
  "license": "AGPL-3.0"
}
